# Production environment template for ArchiveAI backend on GCP
# Copy this file to .env and fill in your actual values before deploying.

# ── Google Cloud Project ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Gemini Models ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ── Vector Store (pgvector in Cloud SQL) ────────────────────────────────────
PGVECTOR_COLLECTION=documents

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
SEARCH_K=8

# ── Upload / Local Storage ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
MARKDOWN_DIR=./data/markdown
STRUCTURE_DIR=./data/structures

# ── Database (Cloud SQL PostgreSQL) ─────────────────────────────────────────
# Use 5432 for Cloud SQL (NOT 5433 — that is local Docker mapping only)
POSTGRES_USER=archiveai
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=archiveai_chat
POSTGRES_HOST=your-cloud-sql-ip
POSTGRES_PORT=5432

# ── CORS ────────────────────────────────────────────────────────────────────
# Add your frontend domains here (Vercel, local dev, etc.)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# ── Logging ─────────────────────────────────────────────────────────────────
# Optional: set to debug for troubleshooting startup issues
# LOG_LEVEL=info
